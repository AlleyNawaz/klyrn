# ============================================================
# ProofPay Environment Variables
# Copy to .env and fill in real values
# ============================================================

# -- Database (Postgres 16) --
# Local dev: use docker compose up
DATABASE_URL="postgresql://proofpay:proofpay@localhost:5432/proofpay?schema=public"

# -- Redis (BullMQ job queue + rate limiting) --
REDIS_URL="redis://localhost:6379"

# -- Solana --
# RPC endpoint (Helius recommended for webhooks + DAS API)
SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"
# Cluster: "devnet" | "mainnet-beta" | "localnet"
SOLANA_CLUSTER="localnet"
# Program ID (generated at first build)
PROGRAM_ID=""
# Arbiter authority keypair path (hot key for MVP — see SECURITY.md)
ARBITER_KEYPAIR_PATH="./keys/arbiter.json"

# -- Helius (Solana RPC + webhooks + DAS API for cNFTs) --
# Get at: https://dev.helius.xyz
HELIUS_API_KEY="YOUR_HELIUS_API_KEY"
HELIUS_WEBHOOK_SECRET="YOUR_HELIUS_WEBHOOK_SECRET"

# -- Privy (embedded wallets + auth) --
# Get at: https://dashboard.privy.io
PRIVY_APP_ID="YOUR_PRIVY_APP_ID"
PRIVY_APP_SECRET="YOUR_PRIVY_APP_SECRET"

# -- Anthropic (Claude for AI arbitration) --
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# -- Resend (transactional email) --
# Get at: https://resend.com
RESEND_API_KEY="YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="noreply@proofpay.app"

# -- Cloudflare R2 (file storage) --
# Get at: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="proofpay-uploads"
R2_PUBLIC_URL="https://uploads.proofpay.app"

# -- MoonPay (fiat on-ramp, optional for MVP) --
# Get at: https://dashboard.moonpay.com
MOONPAY_API_KEY="YOUR_MOONPAY_API_KEY"

# -- App --
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
ARBITER_URL="http://localhost:8000"

# -- Dev / Demo --
# Set to "true" to enable GOD_MODE (skips emails, enables dev endpoints)
GOD_MODE="false"
# USDC mint address (devnet)
USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# -- JWT --
JWT_SECRET="your-jwt-secret-for-api-sessions"
